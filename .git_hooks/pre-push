#!/bin/bash
# Pre-push hook (Sprint 36 B3 — PARITY PERIOD): runs the legacy monolithic hook
# (pre-push-legacy.sh, byte-identical to this hook before B3) AND the new suite-runner
# wrapper, compares their verdicts, and fails loudly on any divergence. This roughly
# doubles wall-clock time (~8-10min -> ~16-20min) for the parity week — a known,
# accepted cost of a safe migration (Sprint 36 Phase B plan). Delete
# pre-push-legacy.sh and everything below the "new path" section once a week of real
# pushes shows zero divergence; keep only the new path as the permanent hook body.
#
# Both paths need the git-supplied pre-push protocol lines from stdin, but stdin can
# only be consumed once — capture it to a file up front (skipped for a TTY invocation,
# where neither path reads stdin anyway; blocking on `cat` there would hang the shell).
STDIN_CAPTURE=$(mktemp)
trap 'rm -f "$STDIN_CAPTURE"' EXIT
if [ -t 0 ]; then
  : > "$STDIN_CAPTURE"
else
  cat > "$STDIN_CAPTURE"
fi

echo "=================================================================="
echo "PARITY PERIOD (Sprint 36 B3): running legacy hook"
echo "=================================================================="
./.git_hooks/pre-push-legacy.sh "$@" < "$STDIN_CAPTURE"
LEGACY_STATUS=$?

echo "=================================================================="
echo "PARITY PERIOD (Sprint 36 B3): running new suite-runner hook"
echo "=================================================================="
(
  if [ -r ./standards/hooks/lib.sh ]; then
    . ./standards/hooks/lib.sh
    RANGES=$(push_ranges < "$STDIN_CAPTURE"); _rc=$?
    [ "$_rc" -eq 2 ] && exit 0   # push only deletes a branch
    CHANGED_FILES=$(changed_files $RANGES)
    assert_detection "$CHANGED_FILES" || exit 1
  else
    LOCAL_SHA=$(git rev-parse HEAD)
    _mr=origin/main; git rev-parse --verify --quiet refs/remotes/github/main >/dev/null 2>&1 && _mr=github/main
    BASE=$(git merge-base "$_mr" "$LOCAL_SHA" 2>/dev/null || git merge-base main "$LOCAL_SHA" 2>/dev/null)
    if [ -n "$BASE" ]; then
      CHANGED_FILES=$(git diff --name-only "$BASE" "$LOCAL_SHA")
      RANGES="$BASE..$LOCAL_SHA"
    else
      CHANGED_FILES=$(git diff --name-only HEAD)
      RANGES=""
    fi
  fi

  export HAS_SCALA=$(echo "$CHANGED_FILES" | grep -cE '\.(scala|sbt)$|^project/')
  export HAS_NATIVE=$(echo "$CHANGED_FILES" | grep -cE '^menger-geometry/src/main/native/.*\.(cpp|cu|cuh|h)$|CMakeLists\.txt')
  export HAS_CI=$(echo "$CHANGED_FILES" | grep -cE '^\.github/workflows/.*\.ya?ml$')
  export HAS_INTEGRATION=$(echo "$CHANGED_FILES" | grep -c '^scripts/integration-tests\.sh$')

  _RENDERING_PATHS_FILE="${RENDERING_PATHS_FILE:-./standards/rendering-paths.txt}"
  export HAS_RENDERING=0
  if [ -r "$_RENDERING_PATHS_FILE" ]; then
    _RENDERING_PATTERNS=$(grep -v '^[[:space:]]*\(#\|$\)' "$_RENDERING_PATHS_FILE" | paste -sd'|' -)
    if [ -n "$_RENDERING_PATTERNS" ]; then
      HAS_RENDERING=$(echo "$CHANGED_FILES" | grep -cE "$_RENDERING_PATTERNS" 2>/dev/null) || HAS_RENDERING=0
      export HAS_RENDERING
    fi
  fi

  export QA_RANGES="$RANGES"
  export QA_REMOTE="$1"

  ./standards/scripts/qa-runner.sh parity policy preflight lint unit native-checks coverage memcheck package integration
) < "$STDIN_CAPTURE"
NEW_STATUS=$?

# WIP override (unchanged semantics): applied uniformly to both statuses so a WIP push
# doesn't register as a spurious divergence.
commit_msg=$(git log --oneline | head -n 1 | cut -d' ' -f 2-)
if echo "$commit_msg" | grep -q '^WIP:'; then
  echo >&2 "Found WIP commit, pushing in spite of failed test suite"
  LEGACY_STATUS=0
  NEW_STATUS=0
fi

LEGACY_OK=0; [ "$LEGACY_STATUS" -eq 0 ] && LEGACY_OK=1
NEW_OK=0; [ "$NEW_STATUS" -eq 0 ] && NEW_OK=1

if [ "$LEGACY_OK" -ne "$NEW_OK" ]; then
  echo "=================================================================="
  echo "PARITY DIVERGENCE: legacy hook exit=$LEGACY_STATUS, new hook exit=$NEW_STATUS"
  echo "This is the Sprint 36 B3 parity-period safety net firing — investigate before"
  echo "trusting the new suite-runner path. Do not delete pre-push-legacy.sh (or this"
  echo "comparison) until this is understood and a full week passes with zero divergence."
  echo "=================================================================="
  exit 1
fi

exit "$LEGACY_STATUS"
