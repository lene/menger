#!/bin/bash
# Pre-push hook (Sprint 36 B3): thin wrapper. Change detection is unchanged
# (standards/hooks/lib.sh); this hook's only job is to compute CHANGED_FILES/QA_RANGES/
# QA_REMOTE and hand them to standards/scripts/qa-runner.sh, which reads qa-manifest.yaml
# to decide which suites are relevant at push tier and runs each one (scripts/suites/*.sh),
# which decides its own PASS/FAIL/SKIP.
#
# Needs the git-supplied pre-push protocol lines from stdin, but stdin can only be
# consumed once — capture it to a file up front (skipped for a TTY invocation, where
# nothing below reads stdin anyway; blocking on `cat` there would hang the shell).
STDIN_CAPTURE=$(mktemp)
trap 'rm -f "$STDIN_CAPTURE"' EXIT
if [ -t 0 ]; then
  : > "$STDIN_CAPTURE"
else
  cat > "$STDIN_CAPTURE"
fi

(
  if [ -r ./standards/hooks/lib.sh ]; then
    . ./standards/hooks/lib.sh
    RANGES=$(push_ranges < "$STDIN_CAPTURE"); _rc=$?
    [ "$_rc" -eq 2 ] && exit 0   # push only deletes a branch
    CHANGED_FILES=$(changed_files $RANGES)
    assert_detection "$CHANGED_FILES" || exit 1
  else
    LOCAL_SHA=$(git rev-parse HEAD)
    _mr=origin/main; git rev-parse --verify --quiet refs/remotes/github/main >/dev/null 2>&1 && _mr=github/main
    BASE=$(git merge-base "$_mr" "$LOCAL_SHA" 2>/dev/null || git merge-base main "$LOCAL_SHA" 2>/dev/null)
    if [ -n "$BASE" ]; then
      CHANGED_FILES=$(git diff --name-only "$BASE" "$LOCAL_SHA")
      RANGES="$BASE..$LOCAL_SHA"
    else
      CHANGED_FILES=$(git diff --name-only HEAD)
      RANGES=""
    fi
  fi

  export CHANGED_FILES
  export QA_RANGES="$RANGES"
  export QA_REMOTE="$1"

  ./standards/scripts/qa-runner.sh --tier push
) < "$STDIN_CAPTURE"
STATUS=$?

commit_msg=$(git log --oneline | head -n 1 | cut -d' ' -f 2-)
if echo "$commit_msg" | grep -q '^WIP:'; then
  echo >&2 "Found WIP commit, pushing in spite of failed test suite"
  STATUS=0
fi

exit "$STATUS"
